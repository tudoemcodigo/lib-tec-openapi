<Project>

  <!--
    Central Package Management: a versão de cada pacote é declarada uma única vez, aqui.
  -->

  <!--
    Componentes TEC.* consumidos: nenhum hoje. Ao consumir um, declare a versão PUBLICADA no feed tec-interno aqui
    (<PackageVersion Include="TEC.X" Version="..." />) e, no csproj, use <TecReference Include="TEC.X" />, sem versão.
  -->

  <!-- Terceiros -->
  <ItemGroup>
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
  </ItemGroup>

  <!-- Pacotes do ASP.NET Core acompanham a versão do framework (net10.0) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

</Project>
